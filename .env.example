# ============================================================================
# Flatrun — Environment Variables Template
# ----------------------------------------------------------------------------
# Copy this file to .env and fill in real values.
# .env is gitignored — safe to put secrets there.
# .env.example IS tracked — never put real secrets here.
# ============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Flatrun
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database ----------------------------------------------------------------
# MVP uses SQLite via Prisma. Production migrates to PostgreSQL (Render/RDS).
DATABASE_URL="file:./db/flatrun.db"

# --- Authentication ----------------------------------------------------------
# MVP uses NextAuth.js. Production migrates to Clerk (SSO/MFA/Organizations).
# Generate a new secret for each environment: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional GitHub OAuth (for NextAuth). Leave empty to use email/password only.
GITHUB_ID=
GITHUB_SECRET=

# --- AI (optional — engine works without AI) --------------------------------
# Used only by Slice 6 (AI Explanation Layer). The deterministic engine produces
# correct results without an OpenAI key.
OPENAI_API_KEY=

# --- Error Tracking (optional for MVP) --------------------------------------
SENTRY_DSN=

# --- File Storage ------------------------------------------------------------
# MVP uses local filesystem. Production migrates to S3-compatible storage.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# --- Clerk (for future migration — not used by MVP) -------------------------
# Pre-provisioned so we can swap from NextAuth to Clerk without code changes.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
